# Stage 1: Build the application
FROM maven:3.9-eclipse-temurin-17 AS build

WORKDIR /app

# Install tools required by the application/build
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        unrar-free \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# Copy Maven configuration first to maximize Docker layer caching
COPY backend/pom.xml ./pom.xml

# Download dependencies
RUN mvn dependency:go-offline

# Copy Git metadata because git-commit-id-plugin requires it
COPY .git .git

# Copy source code
COPY backend/src ./src

# Build the application
RUN mvn package -DskipTests


# Stage 2: Run the application
FROM eclipse-temurin:17-jre

WORKDIR /app

# Copy the JAR from the build stage
COPY --from=build /app/target/*.jar app.jar

# Copy default Slack notification configuration
COPY backend/src/main/resources/notify_slack.json ./default_notify.json

# Create entrypoint
RUN printf '%s\n' \
    '#!/bin/sh' \
    'mkdir -p /data' \
    '[ -f /data/notify_slack.json ] || cp /app/default_notify.json /data/notify_slack.json' \
    'exec java -jar /app/app.jar' \
    > /app/entrypoint.sh \
    && chmod +x /app/entrypoint.sh

VOLUME /data

EXPOSE 8080

ENTRYPOINT ["/app/entrypoint.sh"]
